        <collision name="back_collision"><pose>-0.20 0 0.75 0 0 0</pose><geometry><box><size>0.10 0.48 0.60</size></box></geometry></collision>
        <visual name="back_visual"><pose>-0.20 0 0.75 0 0 0</pose><geometry><box><size>0.10 0.48 0.60</size></box></geometry><material><ambient>0.10 0.38 0.28 1</ambient><diffuse>0.14 0.55 0.40 1</diffuse></material></visual>
      </link>
    </model>

    <model name="meeting_sofa">
      <static>true</static>
      <pose>1.05 -4.02 0 0 0 0</pose>
      <link name="link">
        <collision name="base_collision"><pose>0 0 0.22 0 0 0</pose><geometry><box><size>1.80 0.72 0.44</size></box></geometry></collision>
        <visual name="base_visual"><pose>0 0 0.22 0 0 0</pose><geometry><box><size>1.80 0.72 0.44</size></box></geometry><material><ambient>0.12 0.27 0.38 1</ambient><diffuse>0.17 0.39 0.55 1</diffuse></material></visual>
        <collision name="back_collision"><pose>0 0.29 0.60 0 0 0</pose><geometry><box><size>1.80 0.15 0.78</size></box></geometry></collision>
        <visual name="back_visual"><pose>0 0.29 0.60 0 0 0</pose><geometry><box><size>1.80 0.15 0.78</size></box></geometry><material><ambient>0.12 0.27 0.38 1</ambient><diffuse>0.17 0.39 0.55 1</diffuse></material></visual>
      </link>
    </model>

    <model name="meeting_side_cabinet">
      <static>true</static>
      <pose>-1.72 -3.65 0.47 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.75 1.15 0.94</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.75 1.15 0.94</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.28 0.31 0.34 1</diffuse></material></visual>
        <visual name="handle_visual"><pose>0.39 0 0.10 0 0 0</pose><geometry><box><size>0.04 0.36 0.05</size></box></geometry><material><ambient>0.72 0.74 0.76 1</ambient><diffuse>0.85 0.86 0.88 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ======================= LAB / STORAGE ======================= -->

    <model name="lab_workbench">
      <static>true</static>
      <pose>5.35 3.85 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision"><pose>0 0 0.82 0 0 0</pose><geometry><box><size>2.05 0.78 0.12</size></box></geometry></collision>
        <visual name="top_visual"><pose>0 0 0.82 0 0 0</pose><geometry><box><size>2.05 0.78 0.12</size></box></geometry><material><ambient>0.30 0.32 0.34 1</ambient><diffuse>0.46 0.48 0.50 1</diffuse></material></visual>
        <collision name="left_cabinet_collision"><pose>-0.78 0 0.39 0 0 0</pose><geometry><box><size>0.42 0.70 0.78</size></box></geometry></collision>
        <visual name="left_cabinet_visual"><pose>-0.78 0 0.39 0 0 0</pose><geometry><box><size>0.42 0.70 0.78</size></box></geometry><material><ambient>0.17 0.20 0.24 1</ambient><diffuse>0.25 0.30 0.36 1</diffuse></material></visual>
        <collision name="right_cabinet_collision"><pose>0.78 0 0.39 0 0 0</pose><geometry><box><size>0.42 0.70 0.78</size></box></geometry></collision>
        <visual name="right_cabinet_visual"><pose>0.78 0 0.39 0 0 0</pose><geometry><box><size>0.42 0.70 0.78</size></box></geometry><material><ambient>0.17 0.20 0.24 1</ambient><diffuse>0.25 0.30 0.36 1</diffuse></material></visual>
      </link>
    </model>

    <model name="lab_storage_rack">
      <static>true</static>
      <pose>6.55 0.80 0.85 0 0 0</pose>
      <link name="link">
        <collision name="body_collision"><geometry><box><size>0.48 2.10 1.70</size></box></geometry></collision>
        <visual name="body_visual"><geometry><box><size>0.48 2.10 1.70</size></box></geometry><material><ambient>0.17 0.19 0.22 1</ambient><diffuse>0.26 0.29 0.34 1</diffuse></material></visual>
        <visual name="yellow_bin"><pose>-0.25 -0.48 -0.40 0 0 0</pose><geometry><box><size>0.04 0.68 0.36</size></box></geometry><material><ambient>0.70 0.48 0.06 1</ambient><diffuse>0.92 0.64 0.08 1</diffuse></material></visual>
        <visual name="blue_bin"><pose>-0.25 0.48 0.32 0 0 0</pose><geometry><box><size>0.04 0.68 0.36</size></box></geometry><material><ambient>0.07 0.31 0.55 1</ambient><diffuse>0.09 0.44 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <model name="lab_tall_cabinet">
      <static>true</static>
      <pose>5.85 -0.85 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.10 0.55 1.50</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.10 0.55 1.50</size></box></geometry><material><ambient>0.42 0.45 0.48 1</ambient><diffuse>0.58 0.61 0.64 1</diffuse></material></visual>
        <visual name="left_handle"><pose>-0.12 -0.285 0 0 0 0</pose><geometry><box><size>0.05 0.03 0.30</size></box></geometry><material><ambient>0.12 0.13 0.15 1</ambient><diffuse>0.20 0.21 0.23 1</diffuse></material></visual>
        <visual name="right_handle"><pose>0.12 -0.285 0 0 0 0</pose><geometry><box><size>0.05 0.03 0.30</size></box></geometry><material><ambient>0.12 0.13 0.15 1</ambient><diffuse>0.20 0.21 0.23 1</diffuse></material></visual>
      </link>
    </model>

    <model name="lab_crate_a">
      <static>true</static>
      <pose>3.40 3.85 0.32 0 0 0.18</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.70 0.70 0.64</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.70 0.70 0.64</size></box></geometry><material><ambient>0.48 0.29 0.10 1</ambient><diffuse>0.67 0.41 0.14 1</diffuse></material></visual>
      </link>
    </model>

    <model name="lab_crate_b">
      <static>true</static>
      <pose>4.05 4.15 0.24 0 0 -0.22</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.55 0.55 0.48</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 0.55 0.48</size></box></geometry><material><ambient>0.38 0.23 0.08 1</ambient><diffuse>0.58 0.35 0.11 1</diffuse></material></visual>
      </link>
    </model>

    <model name="lab_stool">
      <static>true</static>
      <pose>4.20 2.85 0 0 0 0</pose>
      <link name="link">
        <collision name="base_collision"><pose>0 0 0.07 0 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.14</length></cylinder></geometry></collision>
        <visual name="base_visual"><pose>0 0 0.07 0 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.14</length></cylinder></geometry><material><ambient>0.12 0.13 0.15 1</ambient><diffuse>0.20 0.21 0.24 1</diffuse></material></visual>
        <collision name="stem_collision"><pose>0 0 0.29 0 0 0</pose><geometry><cylinder><radius>0.045</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="stem_visual"><pose>0 0 0.29 0 0 0</pose><geometry><cylinder><radius>0.045</radius><length>0.44</length></cylinder></geometry><material><ambient>0.32 0.33 0.35 1</ambient><diffuse>0.48 0.49 0.52 1</diffuse></material></visual>
        <collision name="seat_collision"><pose>0 0 0.54 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>0.10</length></cylinder></geometry></collision>
        <visual name="seat_visual"><pose>0 0 0.54 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>0.10</length></cylinder></geometry><material><ambient>0.58 0.16 0.08 1</ambient><diffuse>0.78 0.22 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ======================= MOVING OBSTACLES ======================= -->

    <!-- Slow service cart traversing the middle room and crossing y=0. -->
    <model name="moving_service_cart">
      <static>false</static>
      <pose>-0.65 -3.40 0.30 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>6.0</mass>
          <inertia>
            <ixx>0.281</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.393</iyy><iyz>0</iyz><izz>0.312</izz>
          </inertia>
        </inertial>
        <velocity_decay><linear>0.55</linear><angular>0.75</angular></velocity_decay>
        <collision name="body_collision">
          <geometry><box><size>0.68 0.48 0.60</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="body_visual">
          <geometry><box><size>0.68 0.48 0.60</size></box></geometry>
          <material><ambient>0.76 0.43 0.04 1</ambient><diffuse>0.95 0.58 0.05 1</diffuse></material>
        </visual>
        <visual name="warning_band_visual">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry><box><size>0.70 0.50 0.10</size></box></geometry>
          <material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.12 0.12 0.13 1</diffuse></material>
        </visual>
        <visual name="handle_visual">
          <pose>-0.28 0 0.48 0 0 0</pose>
          <geometry><box><size>0.08 0.40 0.36</size></box></geometry>
          <material><ambient>0.20 0.21 0.23 1</ambient><diffuse>0.33 0.34 0.37 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-trajectory-follower-system"
              name="gz::sim::systems::TrajectoryFollower">
        <link_name>base_link</link_name>
        <loop>true</loop>
        <range_tolerance>0.18</range_tolerance>
        <bearing_tolerance>7.0</bearing_tolerance>
        <zero_vel_on_bearing_reached>true</zero_vel_on_bearing_reached>
        <force>1.05</force>
        <torque>0.75</torque>
        <waypoints>
          <waypoint>-0.65 -3.40</waypoint>
          <waypoint>-0.65 3.45</waypoint>
        </waypoints>
      </plugin>
    </model>

    <!-- Low circular cleaner following a rectangular loop in the lab. -->
    <model name="moving_cleaner">
      <static>false</static>
      <pose>3.35 -3.25 0.13 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>3.0</mass>
          <inertia>
            <ixx>0.091</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.091</iyy><iyz>0</iyz><izz>0.154</izz>
          </inertia>
        </inertial>
        <velocity_decay><linear>0.60</linear><angular>0.82</angular></velocity_decay>
        <collision name="body_collision">
          <geometry><cylinder><radius>0.32</radius><length>0.26</length></cylinder></geometry>
          <surface><friction><ode><mu>0.75</mu><mu2>0.75</mu2></ode></friction></surface>
        </collision>
        <visual name="body_visual">
          <geometry><cylinder><radius>0.32</radius><length>0.26</length></cylinder></geometry>
          <material><ambient>0.08 0.42 0.54 1</ambient><diffuse>0.10 0.61 0.78 1</diffuse></material>
        </visual>
        <visual name="top_visual">
          <pose>0 0 0.145 0 0 0</pose>
          <geometry><cylinder><radius>0.23</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.05 0.08 0.10 1</ambient><diffuse>0.08 0.12 0.15 1</diffuse></material>
        </visual>
        <visual name="direction_visual">
          <pose>0.18 0 0.175 0 0 0</pose>
          <geometry><sphere><radius>0.055</radius></sphere></geometry>
          <material><ambient>0.12 0.80 0.32 1</ambient><diffuse>0.16 1.00 0.42 1</diffuse><emissive>0.04 0.30 0.10 1</emissive></material>
        </visual>
      </link>
      <plugin filename="gz-sim-trajectory-follower-system"
              name="gz::sim::systems::TrajectoryFollower">
        <link_name>base_link</link_name>
        <loop>true</loop>
        <range_tolerance>0.16</range_tolerance>
        <bearing_tolerance>8.0</bearing_tolerance>
        <zero_vel_on_bearing_reached>true</zero_vel_on_bearing_reached>
        <force>0.62</force>
        <torque>0.42</torque>
        <waypoints>
          <waypoint>3.35 -3.25</waypoint>
          <waypoint>5.75 -3.25</waypoint>
          <waypoint>5.75 -2.00</waypoint>
          <waypoint>3.35 -2.00</waypoint>
        </waypoints>
      </plugin>
    </model>

    <!--
      Visual-only target. The environment will teleport this model to every
      newly sampled goal position. Its radius is 0.18 m; success tolerance is
      deliberately a little larger at 0.25 m.
    -->
    <model name="goal_marker">
      <static>true</static>
      <pose>0.75 0 0.018 0 0 0</pose>
      <link name="link">
        <visual name="goal_visual">
          <geometry><cylinder><radius>0.18</radius><length>0.036</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.90 0.16 1</ambient>
            <diffuse>0.06 1.00 0.20 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
            <emissive>0.03 0.45 0.08 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <camera name="user_camera">
      <pose>0 -12.5 14.5 0 0.80 1.5708</pose>
      <view_controller>orbit</view_controller>
      <projection_type>perspective</projection_type>
    </camera>
  </world>
</sdf>
