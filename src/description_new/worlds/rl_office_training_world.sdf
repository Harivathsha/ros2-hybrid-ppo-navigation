<?xml version="1.0" ?>
<sdf version="1.9">
  <!--
    Goal-conditioned LiDAR navigation world for ROS 2 Jazzy + Gazebo Harmonic.

    World frame layout (metres, top view):

      +======================+======================+======================+
      |      OFFICE          |   MEETING / LOUNGE   |     LAB / STORAGE    |
      |  x: -7.0 .. -2.3     |  x: -2.3 .. 2.3     |  x: 2.3 .. 7.0      |
      |                      |                      |                      |
      |             2.0 m door at y = 0            |                      |
      +======================+======================+======================+

    Important model names used later by the learning environment:
      - hv_bot                 robot spawned by the ROS launch file
      - goal_marker            visual-only green goal marker
      - moving_service_cart    vertical moving obstacle in the middle room
      - moving_cleaner         looping moving obstacle in the lab

    All furniture and scenery are made from SDF primitives. No Fuel models,
    meshes, or network downloads are required.
  -->
  <world name="rl_office_training_world">
    <gravity>0 0 -9.8</gravity>

    <physics name="learning_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.56 0.58 0.62 1</ambient>
      <background>0.72 0.78 0.86 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.82 0.82 0.80 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
      <direction>-0.45 0.30 -1.0</direction>
    </light>

    <light name="office_light" type="point">
      <pose>-4.6 0 3.0 0 0 0</pose>
      <diffuse>0.96 0.86 0.70 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
      <attenuation>
        <range>9</range>
        <constant>0.35</constant>
        <linear>0.025</linear>
        <quadratic>0.008</quadratic>
      </attenuation>
    </light>

    <light name="meeting_light" type="point">
      <pose>0 0 3.0 0 0 0</pose>
      <diffuse>0.82 0.92 0.84 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
      <attenuation>
        <range>9</range>
        <constant>0.35</constant>
        <linear>0.025</linear>
        <quadratic>0.008</quadratic>
      </attenuation>
    </light>

    <light name="lab_light" type="point">
      <pose>4.6 0 3.0 0 0 0</pose>
      <diffuse>0.72 0.84 1.00 1</diffuse>
      <specular>0.14 0.14 0.14 1</specular>
      <attenuation>
        <range>9</range>
        <constant>0.35</constant>
        <linear>0.025</linear>
        <quadratic>0.008</quadratic>
      </attenuation>
    </light>

    <!-- One collision plane supports the complete building. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>16 12</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>16 12</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.19 0.20 0.22 1</ambient>
            <diffuse>0.26 0.27 0.29 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual-only floor panels make room identity obvious in recordings. -->
    <model name="office_floor_panel">
      <static>true</static>
      <pose>-4.65 0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4.55 9.75 0.01</size></box></geometry>
          <material>
            <ambient>0.42 0.28 0.17 1</ambient>
            <diffuse>0.52 0.35 0.21 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="meeting_floor_panel">
      <static>true</static>
      <pose>0 0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4.45 9.75 0.01</size></box></geometry>
          <material>
            <ambient>0.18 0.33 0.29 1</ambient>
            <diffuse>0.23 0.42 0.37 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="lab_floor_panel">
      <static>true</static>
      <pose>4.65 0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4.55 9.75 0.01</size></box></geometry>
          <material>
            <ambient>0.20 0.28 0.40 1</ambient>
            <diffuse>0.26 0.36 0.50 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer walls: 14 m x 10 m interior, 1.6 m high. -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 5.0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>14.15 0.15 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>14.15 0.15 1.6</size></box></geometry>
          <material>
            <ambient>0.80 0.82 0.86 1</ambient>
            <diffuse>0.88 0.89 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -5.0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>14.15 0.15 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>14.15 0.15 1.6</size></box></geometry>
          <material>
            <ambient>0.80 0.82 0.86 1</ambient>
            <diffuse>0.88 0.89 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-7.0 0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 10.15 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.15 1.6</size></box></geometry>
          <material>
            <ambient>0.80 0.82 0.86 1</ambient>
            <diffuse>0.88 0.89 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>7.0 0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 10.15 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.15 1.6</size></box></geometry>
          <material>
            <ambient>0.80 0.82 0.86 1</ambient>
            <diffuse>0.88 0.89 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Partition at x=-2.3, with a 2.0 m doorway centred at y=0. -->
    <model name="office_partition_north">
      <static>true</static>
      <pose>-2.3 3.0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 4.0 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 4.0 1.6</size></box></geometry>
          <material>
            <ambient>0.68 0.70 0.74 1</ambient>
            <diffuse>0.78 0.79 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="office_partition_south">
      <static>true</static>
      <pose>-2.3 -3.0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 4.0 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 4.0 1.6</size></box></geometry>
          <material>
            <ambient>0.68 0.70 0.74 1</ambient>
            <diffuse>0.78 0.79 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Partition at x=2.3, with another 2.0 m doorway. -->
    <model name="lab_partition_north">
      <static>true</static>
      <pose>2.3 3.0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 4.0 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 4.0 1.6</size></box></geometry>
          <material>
            <ambient>0.68 0.70 0.74 1</ambient>
            <diffuse>0.78 0.79 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="lab_partition_south">
      <static>true</static>
      <pose>2.3 -3.0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 4.0 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 4.0 1.6</size></box></geometry>
          <material>
            <ambient>0.68 0.70 0.74 1</ambient>
            <diffuse>0.78 0.79 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================= OFFICE FURNITURE ======================= -->

    <model name="office_desk">
      <static>true</static>
      <pose>-5.35 2.85 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 0.76 0 0 0</pose>
          <geometry><box><size>1.60 0.78 0.10</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.76 0 0 0</pose>
          <geometry><box><size>1.60 0.78 0.10</size></box></geometry>
          <material>
            <ambient>0.34 0.19 0.09 1</ambient>
            <diffuse>0.48 0.28 0.13 1</diffuse>
          </material>
        </visual>

        <collision name="left_leg_collision">
          <pose>-0.68 0 0.38 0 0 0</pose>
          <geometry><box><size>0.12 0.66 0.72</size></box></geometry>
        </collision>
        <visual name="left_leg_visual">
          <pose>-0.68 0 0.38 0 0 0</pose>
          <geometry><box><size>0.12 0.66 0.72</size></box></geometry>
          <material>
            <ambient>0.22 0.12 0.06 1</ambient>
            <diffuse>0.34 0.18 0.08 1</diffuse>
          </material>
        </visual>

        <collision name="right_leg_collision">
          <pose>0.68 0 0.38 0 0 0</pose>
          <geometry><box><size>0.12 0.66 0.72</size></box></geometry>
        </collision>
        <visual name="right_leg_visual">
          <pose>0.68 0 0.38 0 0 0</pose>
          <geometry><box><size>0.12 0.66 0.72</size></box></geometry>
          <material>
            <ambient>0.22 0.12 0.06 1</ambient>
            <diffuse>0.34 0.18 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="office_chair">
      <static>true</static>
      <pose>-4.15 2.85 0 0 0 3.14159</pose>
      <link name="link">
        <collision name="base_collision">
          <pose>0 0 0.07 0 0 0</pose>
          <geometry><cylinder><radius>0.23</radius><length>0.14</length></cylinder></geometry>
        </collision>
        <visual name="base_visual">
          <pose>0 0 0.07 0 0 0</pose>
          <geometry><cylinder><radius>0.23</radius><length>0.14</length></cylinder></geometry>
          <material><ambient>0.08 0.09 0.11 1</ambient><diffuse>0.12 0.13 0.16 1</diffuse></material>
        </visual>
        <collision name="stem_collision">
          <pose>0 0 0.28 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.42</length></cylinder></geometry>
        </collision>
        <visual name="stem_visual">
          <pose>0 0 0.28 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.42</length></cylinder></geometry>
          <material><ambient>0.20 0.21 0.24 1</ambient><diffuse>0.30 0.31 0.35 1</diffuse></material>
        </visual>
        <collision name="seat_collision">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>0.50 0.50 0.10</size></box></geometry>
        </collision>
        <visual name="seat_visual">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>0.50 0.50 0.10</size></box></geometry>
          <material><ambient>0.08 0.24 0.42 1</ambient><diffuse>0.10 0.34 0.58 1</diffuse></material>
        </visual>
        <collision name="back_collision">
          <pose>-0.21 0 0.78 0 0 0</pose>
          <geometry><box><size>0.10 0.50 0.62</size></box></geometry>
        </collision>
        <visual name="back_visual">
          <pose>-0.21 0 0.78 0 0 0</pose>
          <geometry><box><size>0.10 0.50 0.62</size></box></geometry>
          <material><ambient>0.08 0.24 0.42 1</ambient><diffuse>0.10 0.34 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="office_bookshelf">
      <static>true</static>
      <pose>-6.60 -2.55 0.80 0 0 0</pose>
      <link name="link">
        <collision name="body_collision">
          <geometry><box><size>0.45 2.35 1.60</size></box></geometry>
