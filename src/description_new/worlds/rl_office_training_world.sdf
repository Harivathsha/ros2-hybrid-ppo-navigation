    <model name="meeting_chair_south">
      <static>true</static>
      <pose>0.85 1.95 0 0 0 1.5708</pose>
      <link name="link">
        <collision name="base_collision"><pose>0 0 0.07 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.14</length></cylinder></geometry></collision>
